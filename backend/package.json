{
  "name": "backend",
  "version": "1.0.0",
  "description": "Lion Finance API",
  "private": true,
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:test": "tsx src/db-test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx src/db/verify.ts",
    "test:prepare": "tsx --import ./src/test/env.ts src/test/prepare-db.ts",
    "test": "npm run test:prepare && node --import tsx --import ./src/test/env.ts --test \"src/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"src/finance/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
