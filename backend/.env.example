# Copy this file to .env and fill in real values. Never commit .env.
PORT=3001

# Browser origins allowed to call the API (comma-separated).
FRONTEND_URL=http://localhost:5173

# Special characters in the password must be URL-encoded
# (e.g. @ -> %40, # -> %23, / -> %2F, : -> %3A, % -> %25).
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/lion_finance

# --- Optional (defaults shown) ---
# NODE_ENV=development            # set to production on a real server (enables Secure cookies, blocks .test logins and the seed)
# APP_TIMEZONE=Asia/Kolkata       # decides what "today" and "overdue" mean
# SESSION_TTL_HOURS=12            # absolute session lifetime
# SESSION_IDLE_MINUTES=60         # sign out after this much inactivity

# Development seed only: password given to every seeded demo account.
# SEED_USER_PASSWORD=LionDev@2026

# Tests use a separate database. Default: DATABASE_URL with "_test" appended to the name.
# TEST_DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/lion_finance_test
