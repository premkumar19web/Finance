# Copy to .env (or .env.local). Only VITE_* variables reach the browser —
# never put secrets in this file.

# Development: "/api" goes through the Vite proxy to http://localhost:3001 (see vite.config.ts).
# Production: the API's public URL, e.g. https://api.example.com/api, or "/api" when a
# reverse proxy serves the frontend and the API on the same domain.
VITE_API_BASE_URL=/api
